              {
                "type": "null"
              }
            ],
            "title": "Region"
          }
        },
        "required": [
          "name",
          "address",
          "postal_code",
          "planning_area",
          "region"
        ],
        "title": "VenueOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SG Events API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/areas": {
      "get": {
        "operationId": "list_areas_areas_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AreaOut"
                  },
                  "title": "Response List Areas Areas Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Areas",
        "tags": [
          "areas"
        ]
      }
    },
    "/areas/resolve": {
      "get": {
        "operationId": "resolve_postal_areas_resolve_get",
        "parameters": [
          {
            "description": "6-digit Singapore postal code",
            "in": "query",
            "name": "postal",
            "required": true,
            "schema": {
              "description": "6-digit Singapore postal code",
              "title": "Postal",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AreaOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Resolve Postal",
        "tags": [
          "areas"
        ]
      }
    },
    "/ask": {
      "post": {
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask",
        "tags": [
          "ask"
        ]
      }
    },
    "/categories": {
      "get": {
        "description": "The category taxonomy; the app renders its own labels and icons from the ids.",
        "operationId": "categories_categories_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "title": "Response Categories Categories Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Categories"
      }
    },
    "/events": {
      "get": {
        "operationId": "list_events_events_get",
        "parameters": [
          {
            "description": "Repeatable; matches any. See GET /categories.",
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Repeatable; matches any. See GET /categories.",
              "title": "Category"
            }
          },
          {
            "description": "Preset window in SGT; excludes date_from/date_to.",
            "in": "query",
            "name": "when",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "today",
                    "weekend",
                    "week",
                    "month"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Preset window in SGT; excludes date_from/date_to.",
              "title": "When"
            }
          },
          {
            "description": "ISO date (SGT day) or datetime. Default: now.",
            "in": "query",
            "name": "date_from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO date (SGT day) or datetime. Default: now.",
              "title": "Date From"
            }
          },
          {
            "description": "Inclusive ISO date or datetime. Default: 30 days on.",
            "in": "query",
            "name": "date_to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive ISO date or datetime. Default: 30 days on.",
              "title": "Date To"
            }
          },
          {
            "in": "query",
            "name": "lat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lat"
            }
          },
          {
            "in": "query",
            "name": "lng",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lng"
            }
          },
          {
            "description": "Used with lat/lng.",
            "in": "query",
            "name": "radius_km",
            "required": false,
            "schema": {
              "default": 5.0,
              "description": "Used with lat/lng.",
              "exclusiveMinimum": 0,
              "maximum": 50,
              "title": "Radius Km",
              "type": "number"
            }
          },
          {
            "description": "Planning area, e.g. SENGKANG ('events in').",
            "in": "query",
            "name": "area",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Planning area, e.g. SENGKANG ('events in').",
              "title": "Area"
            }
          },
          {
            "description": "CENTRAL, EAST, NORTH, NORTH-EAST or WEST.",
            "in": "query",
            "name": "region",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "CENTRAL, EAST, NORTH, NORTH-EAST or WEST.",
              "title": "Region"
            }
          },
          {
            "in": "query",
            "name": "free",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Free"
            }
          },
          {
            "description": "Default: exclude when searching around a point, include otherwise.",
            "in": "query",
            "name": "online",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "include",
                    "exclude",
                    "only"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default: exclude when searching around a point, include otherwise.",
              "title": "Online"
            }
          },
          {
            "description": "Also show students/members/alumni-only events.",
            "in": "query",
            "name": "include_restricted",
            "required": false,
            "schema": {
              "default": false,
              "description": "Also show students/members/alumni-only events.",
              "title": "Include Restricted",
              "type": "boolean"
            }
          },
          {
            "description": "Default: distance with lat/lng, soonest otherwise.",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "soonest",
                    "distance",
                    "blend"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Default: distance with lat/lng, soonest otherwise.",
              "title": "Sort"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 10000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Events",
        "tags": [
          "events"
        ]
      }
    },
