# Keep LF everywhere (Docker, shell scripts and Python all expect it), even on Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat eol=crlf
*.cmd eol=crlf
*.ps1 eol=crlf

# Saved source responses must stay byte-for-byte as fetched (e.g. CRLF in ICS feeds)
backend/tests/fixtures/** -text

# Binary fixtures and assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.ico binary
