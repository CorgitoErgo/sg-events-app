# Copy to .env and fill in. Never commit .env.

# --- Database (docker-compose.yml reads POSTGRES_*; the backend reads DATABASE_URL) ---
POSTGRES_USER=sgevents
POSTGRES_PASSWORD=sgevents
POSTGRES_DB=sgevents
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sgevents:sgevents@127.0.0.1:5432/sgevents

# --- Anthropic: extraction, classification, query parsing (Haiku), /ask answers (Sonnet) ---
ANTHROPIC_API_KEY=
# Optional overrides (defaults per CLAUDE.md)
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001   # classification, query parsing
# ANTHROPIC_ANSWER_MODEL=claude-sonnet-5            # /ask answers

# --- Voyage AI: embeddings (first 200M tokens free). Without a payment method on the
# account, Voyage allows only 3 requests / 10K tokens per minute: add one to lift that. ---
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4

# --- OneMap (SLA): geocoding + planning areas. Free account: onemap.gov.sg ---
# Either email/password (tokens renew automatically) or a pasted token (lasts 3 days).
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_TOKEN=

# --- Discovery agent (auto-search). Free key at tavily.com: 1,000 searches a month, no card. ---
TAVILY_API_KEY=
# Google Gemini reads event pages that have no schema.org data (preferred over Anthropic when set).
# Free key at aistudio.google.com. On the free tier Google may use requests to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Hard limits per run (the first one reached stops the run). Defaults shown.
# AUTOSEARCH_MAX_SEARCHES=10
# AUTOSEARCH_MAX_PAGES=40
# AUTOSEARCH_MAX_EVENTS=25
# AUTOSEARCH_MAX_PER_DOMAIN=5
# AUTOSEARCH_MAX_MINUTES=10

# --- Crawler alerts (optional): a Slack or Discord incoming-webhook URL. Always logged too. ---
ALERT_WEBHOOK_URL=

# --- Eventbrite: organiser/venue lookups only. Use the "Private token", not the API key ---
EVENTBRITE_TOKEN=
