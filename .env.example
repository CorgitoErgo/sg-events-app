# Copy to .env and fill in. Never commit .env.

# --- Database (docker-compose.yml reads POSTGRES_*; the backend reads DATABASE_URL) ---
POSTGRES_USER=sgevents
POSTGRES_PASSWORD=sgevents
POSTGRES_DB=sgevents
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sgevents:sgevents@127.0.0.1:5432/sgevents

# --- Anthropic: extraction, classification, query parsing (Haiku), /ask answers (Sonnet) ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-haiku-4-5-20251001 (per CLAUDE.md)
# ANTHROPIC_FAST_MODEL=

# --- Voyage AI: embeddings ---
VOYAGE_API_KEY=

# --- OneMap (SLA): geocoding + planning areas. Free account: onemap.gov.sg ---
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# --- Eventbrite: organiser/venue lookups only ---
EVENTBRITE_TOKEN=
